#
# Copy to .env (git-ignored) and fill in. Never commit real keys. The Makefile sources this
# file with the shell (`set -a; . ./.env`), so quote values that contain spaces or `#`.
# Outside make: `set -a; . ./.env; set +a` before running scripts directly.

# B2 S3-compatible endpoint and region for your bucket (shown on the bucket's details page).
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
# Replace with your bucket name (globally unique).
B2_BUCKET=my-gr00t-datasets

# Application key restricted to B2_BUCKET with listBuckets, listFiles, readFiles, writeFiles.
# Leave out deleteFiles: nothing in this sample deletes B2 data.
# Read by the AIS target container and by tools that talk to B2 directly (seed, `bench`,
# `verify ARGS="--direct"`). GR00T trainer subprocesses never receive it.
B2_KEY_ID=
B2_APP_KEY=

# AIS proxy. The default is the local Compose cluster; point it at an existing cluster
# (e.g. ais-k8s) and run `make attach` instead of `make up`.
AIS_ENDPOINT=http://127.0.0.1:51080
# Optional: host directory for the Compose AIS cache, e.g. /mnt/nvme/ais. Defaults to a
# Docker volume on the root disk, which is often small on cloud GPU instances.
# AIS_CACHE_DIR=

# Optional: Hugging Face token for `seed_b2.py --hf-repo`. GR00T also needs access to the
# gated nvidia/Cosmos-Reason2-2B backbone; run `hf auth login` on the training node.
HF_TOKEN=

# Opt in to `make test-integration`, which writes test objects under it/ in B2_BUCKET and
# never deletes them. Use a dedicated test bucket with a lifecycle rule on prefix `it/`.
# B2_IT=1
